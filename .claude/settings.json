{
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "superpowers@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(uv sync:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(pre-commit run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)"
    ],
    "deny": [
      "Read(/**/.env)",
      "Read(/**/*.pem)",
      "Read(/**/*.key)",
      "Read(/**/*.p8)",
      "Read(/**/*.p12)",
      "Read(/**/*.pfx)",
      "Read(/**/*credentials*.json)",
      "Read(/**/*service-account*.json)",
      "Read(/**/*.tfvars)",
      "Read(/**/*.tfvars.json)",
      "Read(/**/.envrc)",
      "Read(/**/kubeconfig)",
      "Read(/**/.databrickscfg)",
      "Read(/**/profiles.yml)",
      "Read(/**/.env.local)",
      "Read(/**/.env.*.local)",
      "Read(/**/.env.prod*)",
      "Read(/**/.env.dev*)",
      "Read(/**/.env.staging*)",
      "Read(/**/.env.test*)",
      "Read(/**/.env.ci*)",
      "Read(/**/.env.backup*)",
      "Read(/**/.env.bak*)",
      "Read(/**/.env.old*)",
      "Read(~/Data Engineering/Proyectos Data/**/.env)",
      "Read(~/Data Engineering/Proyectos Data/**/*.pem)",
      "Read(~/Data Engineering/Proyectos Data/**/*.key)",
      "Read(~/Data Engineering/Proyectos Data/**/*.p8)",
      "Read(~/Data Engineering/Proyectos Data/**/*.p12)",
      "Read(~/Data Engineering/Proyectos Data/**/*.pfx)",
      "Read(~/Data Engineering/Proyectos Data/**/*credentials*.json)",
      "Read(~/Data Engineering/Proyectos Data/**/*service-account*.json)",
      "Read(~/Data Engineering/Proyectos Data/**/*.tfvars)",
      "Read(~/Data Engineering/Proyectos Data/**/*.tfvars.json)",
      "Read(~/Data Engineering/Proyectos Data/**/.envrc)",
      "Read(~/Data Engineering/Proyectos Data/**/kubeconfig)",
      "Read(~/Data Engineering/Proyectos Data/**/.databrickscfg)",
      "Read(~/Data Engineering/Proyectos Data/**/profiles.yml)",
      "Read(~/Data Engineering/Proyectos Data/**/.env.local)",
      "Read(~/Data Engineering/Proyectos Data/**/.env.*.local)",
      "Read(~/Data Engineering/Proyectos Data/**/.env.prod*)",
      "Read(~/Data Engineering/Proyectos Data/**/.env.dev*)",
      "Read(~/Data Engineering/Proyectos Data/**/.env.staging*)",
      "Read(~/Data Engineering/Proyectos Data/**/.env.test*)",
      "Read(~/Data Engineering/Proyectos Data/**/.env.ci*)",
      "Read(~/Data Engineering/Proyectos Data/**/.env.backup*)",
      "Read(~/Data Engineering/Proyectos Data/**/.env.bak*)",
      "Read(~/Data Engineering/Proyectos Data/**/.env.old*)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.databrickscfg)",
      "Read(~/.kube/**)"
    ]
  },
  "enabledMcpjsonServers": [
    "context7"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/world-status.sh\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
